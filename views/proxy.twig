{% extends "models/base.twig" %}
{% block pageName %}Proxy{% endblock %}
{% block headerIncludes %}
    <link rel="stylesheet" href="/assets/css/proxy.css?t=2">
    {# fetched while the page settles, so the first site opens without waiting on them #}
    <link rel="prefetch" href="/proxy/s/scram/scramjet.wasm.wasm">
    <link rel="prefetch" href="/proxy/s/epoxy/index.mjs?v={{ proxyVersion }}">
{% endblock %}
{% block body %}
<div class="page proxyPage" id="proxyPage">
    <section class="proxyHome" id="proxyHome">
        <p class="eyebrow">Proxy</p>
        <h1>Go <em>anywhere</em>.</h1>
        <form class="proxySearch" id="proxyForm" role="search">
            <i class="ph-bold ph-magnifying-glass" aria-hidden="true"></i>
            <input id="proxyInput" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Search, or type an address" aria-label="Search, or type an address" autofocus>
            <button class="button" type="submit">Go</button>
        </form>

        <nav class="proxyLinks" aria-label="Quick links">
            <button type="button" class="proxyLink" data-url="https://www.youtube.com"><i class="ph-bold ph-youtube-logo"></i>YouTube</button>
            <button type="button" class="proxyLink" data-url="https://discord.com/app"><i class="ph-bold ph-discord-logo"></i>Discord</button>
            <button type="button" class="proxyLink" data-url="https://scratch.mit.edu"><i class="ph-bold ph-puzzle-piece"></i>Scratch</button>
            <button type="button" class="proxyLink" data-url="https://open.spotify.com"><i class="ph-bold ph-spotify-logo"></i>Spotify</button>
            <button type="button" class="proxyLink" data-url="https://en.wikipedia.org"><i class="ph-bold ph-book-open"></i>Wikipedia</button>
            <button type="button" class="proxyLink" data-url="https://github.com"><i class="ph-bold ph-github-logo"></i>GitHub</button>
        </nav>

        <details class="proxySettings">
            <summary>Settings</summary>
            <div class="proxySettingsBody">
                <div class="field">
                    <label for="proxyEngine">Search with</label>
                    <select id="proxyEngine">
                        <option value="ddg">DuckDuckGo</option>
                        <option value="google">Google</option>
                        <option value="bing">Bing</option>
                        <option value="brave">Brave</option>
                    </select>
                </div>
                <div class="field">
                    <label for="proxyTransport">Connection</label>
                    <select id="proxyTransport">
                        <option value="epoxy">Fast (epoxy)</option>
                        <option value="libcurl">Compatible (libcurl)</option>
                    </select>
                    <p class="muted small">If a site won't load, try the other one.</p>
                </div>
            </div>
        </details>

        <p class="proxyNote muted">Sites see this server instead of you. Encryption happens in your browser, so the server
            only knows which sites you open, not what's on them. Some sites (Google sign in, banks) don't like proxies.</p>
    </section>

    <section class="proxyBrowser" id="proxyBrowser" hidden>
        <div class="proxyBar">
            <button type="button" class="button quiet" id="proxyBack" title="Back"><i class="ph-bold ph-arrow-left"></i><span class="sr-only">Back</span></button>
            <button type="button" class="button quiet" id="proxyForward" title="Forward"><i class="ph-bold ph-arrow-right"></i><span class="sr-only">Forward</span></button>
            <button type="button" class="button quiet" id="proxyReload" title="Reload"><i class="ph-bold ph-arrow-clockwise"></i><span class="sr-only">Reload</span></button>
            <form class="proxyAddress" id="proxyAddressForm">
                <input id="proxyAddress" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Address">
            </form>
            <button type="button" class="button quiet" id="proxyNewTab" title="Open in a new tab"><i class="ph-bold ph-arrow-square-out"></i><span class="sr-only">Open in a new tab</span></button>
            <button type="button" class="button quiet" id="proxyFullscreen" title="Fullscreen"><i class="ph-bold ph-arrows-out"></i><span class="sr-only">Fullscreen</span></button>
            <button type="button" class="button quiet" id="proxyHomeButton" title="Close"><i class="ph-bold ph-x"></i><span class="sr-only">Close</span></button>
        </div>
        <div class="proxyFrame" id="proxyFrame">
            <div class="proxyLoading" id="proxyLoading" hidden></div>
        </div>
    </section>

    <div class="notice danger" id="proxyError" role="alert" hidden></div>
</div>
<script type="application/json" id="proxyData">{{ proxyData|raw }}</script>
<script src="/assets/js/proxy.js?t=2" defer></script>
{% endblock %}
{% block footer %}{% endblock %}
