{% extends "models/base.twig" %}
{% import "components/games.twig" as g %}
{% import "components/avatar.twig" as a %}
{% block pageName %}{{ profile.username }}{% endblock %}
{% block ogTitle %}{{ profile.username }} on {{ env("APP_NAME") }}{% endblock %}
{% block ogDescription %}{{ profile.blurb ?: profile.username ~ ' plays games on ' ~ env("APP_NAME") ~ '.' }}{% endblock %}
{% block ogImage %}{{ profile.avatar }}{% endblock %}
{% block body %}
<div class="page">
    <div class="profileHeader">
        {{ a.avatar(profile, 'large') }}
        <div>
            <h1>{{ profile.username }} <span class="levelBadge large" title="Level {{ profile.level }}">Lv {{ profile.level }}</span></h1>
            <p class="muted">Joined {{ profile.registered|date("F Y") }} · {{ friendCount }} friend{{ friendCount == 1 ? '' : 's' }}</p>
            {% if profile.blurb %}<p class="blurb">{{ profile.blurb }}</p>{% endif %}
        </div>
        {% if currentuser and currentuser.id == profile.id %}
            <a class="button quiet" href="/settings">Edit profile</a>
        {% elseif currentuser and relation and relation != 'blockedby' %}
            <div class="friendActions" id="friendActions" data-id="{{ profile.id }}" data-username="{{ profile.username }}" data-relation="{{ relation }}">
                {% if relation == 'friends' %}
                    <button class="button" type="button" data-chat><i class="ph-bold ph-chat-circle"></i>Message</button>
                {% elseif relation == 'incoming' %}
                    <button class="button" type="button" data-act="accept">Accept friend request</button>
                    <button class="button quiet" type="button" data-act="decline">Decline</button>
                {% elseif relation == 'outgoing' %}
                    <button class="button quiet" type="button" data-act="cancel">Request sent · Cancel</button>
                {% elseif relation == 'blocked' %}
                    <button class="button quiet" type="button" data-act="unblock">Unblock</button>
                {% else %}
                    <button class="button" type="button" data-act="request"><i class="ph-bold ph-user-plus"></i>Add friend</button>
                {% endif %}
                {% if relation != 'blocked' %}
                <details class="moreMenu">
                    <summary class="button quiet" aria-label="More"><i class="ph-bold ph-dots-three"></i></summary>
                    <div class="moreMenuItems">
                        {% if relation == 'friends' %}<button type="button" data-act="remove" data-confirm="Unfriend {{ profile.username }}?">Unfriend</button>{% endif %}
                        <button type="button" data-act="block" data-confirm="Block {{ profile.username }}? They won't be able to message you or send you friend requests.">Block</button>
                    </div>
                </details>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% if shares and totalPlaytime %}
    <dl class="figures profileFigures">
        <div><dt>Played for</dt><dd>{{ totalPlaytime|playtime }}</dd></div>
        <div><dt>Games tried</dt><dd>{{ gamesPlayed|number_format }}</dd></div>
        <div><dt>Achievements</dt><dd>{{ achievements.count }}<span class="figureOf">/{{ achievements.list|length }}</span></dd></div>
        <div><dt>Streak</dt><dd>{{ streak }} <span class="figureOf">{{ streak == 1 ? 'day' : 'days' }}</span></dd>{% if profile.streak_best > 1 %}<dd class="figureNote">best {{ profile.streak_best }}</dd>{% endif %}</div>
    </dl>
    {% endif %}

    {% if mostPlayed is not empty %}
    <section>
        <div class="sectionHeader">
            <h2>Most played</h2>
        </div>
        <ol class="mostPlayed">
            {% for game in mostPlayed %}
            <li>
                <a href="/{{ game.type == 'app' ? 'apps' : 'games' }}/{{ game.id }}">
                    <span class="gameIcon small">{% if game.gameIcon %}<img src="{{ game.gameIcon }}" alt="" loading="lazy">{% else %}{{ game.name|first|upper }}{% endif %}</span>
                    <span class="mostPlayedName">{{ game.name }}</span>
                </a>
                <span class="mostPlayedBar" aria-hidden="true"><span style="width: {{ (game.seconds / mostPlayed[0].seconds * 100)|round }}%"></span></span>
                <span class="mostPlayedTime">{{ game.seconds|playtime }}</span>
            </li>
            {% endfor %}
        </ol>
    </section>
    {% endif %}

    {% if collections is not empty %}
    <section id="collections">
        <div class="sectionHeader">
            <h2>Collections</h2>
            {% if currentuser and currentuser.id == profile.id %}<a href="/collections/mine">Manage</a>{% endif %}
        </div>
        {{ g.collectionGrid(collections) }}
    </section>
    {% endif %}

    <section id="achievements">
        <div class="sectionHeader">
            <h2>Achievements <span class="muted">{{ achievements.count }} of {{ achievements.list|length }}</span></h2>
        </div>
        <ul class="achievementGrid">
            {% for item in achievements.list %}
            <li class="achievement{{ item.earned ? ' earned' : '' }}">
                <span class="achievementIcon"><i class="{{ item.earned ? 'ph-fill' : 'ph-bold' }} {{ item.icon }}"></i></span>
                <span class="achievementText">
                    <strong>{{ item.name }}</strong>
                    <span>{{ item.text }}</span>
                    {% if item.earned %}<span class="achievementDate">{{ item.earned|date("M j, Y") }}</span>{% endif %}
                </span>
            </li>
            {% endfor %}
        </ul>
    </section>

    <section>
        <div class="sectionHeader">
            <h2>Favorite games</h2>
        </div>
        {% if favorites is empty %}
            {{ g.empty('blobthinking', 'No favorites yet.', 'Guess they\'re still deciding.') }}
        {% else %}
            {{ g.grid(favorites) }}
        {% endif %}
    </section>
</div>
{% endblock %}
