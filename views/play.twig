{% extends "models/base.twig" %}
{% import "components/games.twig" as g %}
{% import "components/avatar.twig" as a %}
{% set isApp = game.type == 'app' %}
{% block pageName %}{{ game.name }}{% endblock %}
{% block ogTitle %}{{ isApp ? '' : 'Play ' }}{{ game.name }} on {{ env("APP_NAME") }}{% endblock %}
{% block ogDescription %}{{ game.description ?: (isApp ? game.name ~ ', right in your browser.' : 'Play ' ~ game.name ~ ' free in your browser, no downloads.') }}{% endblock %}
{% block ogImage %}{{ screenshots ? screenshots|first : game.gameIcon }}{% endblock %}
{% block twitterCard %}{{ screenshots ? 'summary_large_image' : 'summary' }}{% endblock %}
{% block headerIncludes %}
    <link rel="stylesheet" href="/assets/css/gamepage.css?t=16">
{% endblock %}
{% block body %}
<div class="page playPage">
    <div class="player" id="player">
        {# with cloud saves on, play.js sets src once the save is back in localStorage #}
        <iframe id="gameFrame" {{ cloudOn ? 'data-src' : 'src' }}="{{ game.gamePath }}" title="{{ game.name }}" allow="fullscreen; gamepad; autoplay" allowfullscreen></iframe>
    </div>

    <div class="playBar">
        <div class="playTitle">
            <span class="gameIcon small">
                {% if game.gameIcon %}<img src="{{ game.gameIcon }}" alt="">{% else %}{{ game.name|first|upper }}{% endif %}
            </span>
            <div>
                <h1>{{ game.name }}{% if isGotd %} <span class="gotdBadge" title="Game of the day"><i class="ph-fill ph-sun"></i>Game of the day</span>{% endif %}</h1>
                <p class="muted">{{ game.plays|number_format }} {% if isApp %}{{ game.plays == 1 ? 'open' : 'opens' }}{% else %}{{ game.plays == 1 ? 'play' : 'plays' }}{% endif %} · <span id="favoriteCount">{{ game.favorites|number_format }}</span> <span id="favoriteLabel">{{ game.favorites == 1 ? 'favorite' : 'favorites' }}</span>{% if rating is not null %} · <span id="ratingText">{{ rating }}% liked</span>{% else %} <span id="ratingText"></span>{% endif %}</p>
                {% if currentuser %}
                <p class="playStats">
                    <span id="playtimeText" title="Only counts while this tab is in front and the window is focused"><i class="ph-bold ph-clock"></i>{% if played and played.seconds %}{{ played.seconds|playtime }} played{% else %}Not played yet{% endif %}</span>
                    <span class="cloudStatus" id="cloudStatus" hidden><i class="ph-bold ph-cloud"></i><span></span></span>
                </p>
                {% endif %}
            </div>
        </div>
        <div class="playActions">
            {% if currentuser %}
                <div class="voteButtons" role="group" aria-label="Rate {{ game.name }}">
                    <button class="button quiet{{ myVote == 1 ? ' on' : '' }}" id="voteUp" data-vote="1" aria-pressed="{{ myVote == 1 ? 'true' : 'false' }}" title="I like it"><i class="{{ myVote == 1 ? 'ph-fill' : 'ph-bold' }} ph-thumbs-up"></i><span id="likeCount">{{ game.likes|compact }}</span></button>
                    <button class="button quiet{{ myVote == -1 ? ' on' : '' }}" id="voteDown" data-vote="-1" aria-pressed="{{ myVote == -1 ? 'true' : 'false' }}" title="Not for me"><i class="{{ myVote == -1 ? 'ph-fill' : 'ph-bold' }} ph-thumbs-down"></i><span class="sr-only">Dislike</span></button>
                </div>
                <button class="button quiet{{ favorited ? ' on' : '' }}" id="favoriteButton" data-id="{{ game.id }}" aria-pressed="{{ favorited ? 'true' : 'false' }}">
                    <i class="{{ favorited ? 'ph-fill' : 'ph-bold' }} ph-heart"></i><span>{{ favorited ? 'Favorited' : 'Favorite' }}</span>
                </button>
            {% else %}
                <a class="button quiet" href="/auth/sign-in" title="Sign in to save favorites"><i class="ph-bold ph-heart"></i>Favorite</a>
            {% endif %}
            {% if currentuser %}<button class="button quiet" id="collectButton" title="Add to a collection"><i class="ph-bold ph-folder-plus"></i><span class="sr-only">Add to a collection</span></button>{% endif %}
            <a class="button quiet" href="{{ game.gamePath }}" target="_blank" rel="noopener" title="Open in a new tab"><i class="ph-bold ph-arrow-square-out"></i><span class="sr-only">Open in a new tab</span></a>
            <button class="button quiet" id="theaterButton" aria-pressed="false" title="Theater mode (T)"><i class="ph-bold ph-frame-corners"></i><span class="sr-only">Theater mode</span></button>
            {% if currentuser %}<button class="button quiet" id="reportGameButton" title="Report a problem"><i class="ph-bold ph-flag"></i><span class="sr-only">Report a problem</span></button>{% endif %}
            <button class="button" id="fullscreenButton" title="Fullscreen (F)"><i class="ph-bold ph-arrows-out"></i>Fullscreen</button>
        </div>
    </div>
    <div class="notice danger" id="playError" role="alert" hidden></div>
    <div class="notice success" id="playMsg" role="status" hidden></div>

    {% if tags is not empty %}
    <nav class="tagChips small" aria-label="Categories">
        {% for tag in tags %}<a class="tagChip" href="/{{ isApp ? 'apps' : 'games' }}?tag={{ tag.slug }}">{{ tag.name }}</a>{% endfor %}
    </nav>
    {% endif %}

    {% for c in challenges %}
    <div class="notice challengeNotice"><i class="ph-bold ph-sword"></i><span><a href="/users/{{ c.username|lower|url_encode }}">{{ c.username }}</a> challenged you to beat <strong>{{ c.text }}</strong>. Good luck.</span></div>
    {% endfor %}

    {% if currentuser %}
    <dialog class="modal" id="collectDialog" aria-labelledby="collectTitle">
        <form method="dialog" id="collectForm">
            <h2 id="collectTitle">Add {{ game.name }} to a collection</h2>
            <ul class="collectList" id="collectList"><li class="muted">Loading…</li></ul>
            <div class="field">
                <label for="collectNew">Or start a new one</label>
                <div class="inputRow">
                    <input id="collectNew" maxlength="60" placeholder="Best 2 player games">
                    <button type="button" class="button quiet" id="collectCreate">Create</button>
                </div>
            </div>
            <div class="notice danger" id="collectError" role="alert" hidden></div>
            <div class="modalActions">
                <a class="button quiet" href="/collections/mine">Your collections</a>
                <button type="button" class="button" id="collectDone">Done</button>
            </div>
        </form>
    </dialog>

    <dialog class="modal" id="reportGameDialog" aria-labelledby="reportGameTitle">
        <form method="dialog" id="reportGameForm">
            <h2 id="reportGameTitle">What's wrong with {{ game.name }}?</h2>
            <fieldset class="radioList">
                <legend class="sr-only">Problem</legend>
                {% for key, label in brokenReasons %}
                <label class="checkRow"><input type="radio" name="reason" value="{{ key }}"{% if loop.first %} required{% endif %}><span>{{ label }}</span></label>
                {% endfor %}
            </fieldset>
            <div class="field">
                <label for="reportGameDetails">Anything else? <span class="muted">(optional)</span></label>
                <textarea id="reportGameDetails" maxlength="1000" rows="3" placeholder="What browser or device, what you tried..."></textarea>
            </div>
            <div class="notice danger" id="reportGameError" role="alert" hidden></div>
            <div class="modalActions">
                <button type="button" class="button quiet" value="cancel" id="reportGameCancel">Cancel</button>
                <button type="submit" class="button" id="reportGameSend">Send report</button>
            </div>
        </form>
    </dialog>
    {% endif %}

    {% if screenshots is not empty %}
    <div class="shotStrip" aria-label="Screenshots">
        {% for shot in screenshots %}
        <a href="{{ shot }}" target="_blank" rel="noopener"><img src="{{ shot }}" alt="{{ game.name }} screenshot {{ loop.index }}" loading="lazy"></a>
        {% endfor %}
    </div>
    {% endif %}

    {% if game.description or game.controls %}
    <div class="aboutRow">
        {% if game.description %}
        <div class="playDescription">
            <h2>About</h2>
            <p>{{ game.description|nl2br }}</p>
        </div>
        {% endif %}
        {% if game.controls %}
        <div class="playDescription playControls">
            <h2>How to play</h2>
            <ul>
                {% for line in game.controls|split("\n") %}{% if line|trim %}<li>{{ line|trim }}</li>{% endif %}{% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if scoresOn %}
    <section class="leaderboard" id="scores">
        <div class="sectionHeader">
            <h2>Leaderboard</h2>
            <nav class="sortTabs" aria-label="Which leaderboard">
                <a href="#scores" data-period="all" class="active" aria-current="true">All time</a>
                <a href="#scores" data-period="week">This week</a>
                {% if currentuser %}<a href="#scores" data-period="friends">Friends</a>{% endif %}
            </nav>
        </div>
        <ol class="scoreList" id="scoreList"><li class="muted">Loading…</li></ol>
        <div class="scoreFooter">
            <p class="muted" id="scoreMine"></p>
            {% if currentuser %}<button class="button quiet" type="button" id="challengeButton" hidden><i class="ph-bold ph-sword"></i>Challenge a friend</button>{% endif %}
        </div>
        {% if not currentuser %}<p class="muted"><a href="/auth/sign-in">Sign in</a> to get on the board.</p>{% endif %}
    </section>

    {% if currentuser %}
    <dialog class="modal" id="challengeDialog" aria-labelledby="challengeTitle">
        <form method="dialog" id="challengeForm">
            <h2 id="challengeTitle">Who should try to beat you?</h2>
            <p class="muted">They get a notification with your best, <span id="challengeScore"></span>. If they beat it, you'll hear about it.</p>
            <div class="field">
                <label for="challengeFriend">Friend</label>
                <select id="challengeFriend" required><option value="">Loading…</option></select>
            </div>
            <div class="notice danger" id="challengeError" role="alert" hidden></div>
            <div class="modalActions">
                <button type="button" class="button quiet" id="challengeCancel">Cancel</button>
                <button type="submit" class="button" id="challengeSend">Send challenge</button>
            </div>
        </form>
    </dialog>
    {% endif %}
    {% endif %}

    {% if commentsOn %}
    <section class="comments" id="comments">
        <h2>Comments <span class="commentCount" id="commentCount">{{ commentCount|number_format }}</span></h2>

        {% if currentuser and muteMessage %}
        <p class="notice">{{ muteMessage }}</p>
        {% elseif currentuser %}
        <form class="commentForm" id="commentForm">
            {{ a.avatar(currentuser) }}
            <div class="commentInput">
                <label class="sr-only" for="commentText">Write a comment</label>
                <textarea id="commentText" rows="2" maxlength="{{ commentMax }}" placeholder="What did you think of {{ game.name }}?"></textarea>
                <div class="commentFormBar">
                    <span class="commentChars muted" id="commentChars"></span>
                    <button class="button" type="submit" id="commentSend">Post</button>
                </div>
            </div>
        </form>
        {% else %}
        <p class="muted"><a href="/auth/sign-in">Sign in</a> to leave a comment.</p>
        {% endif %}

        <div class="notice danger" id="commentMsg" role="alert" hidden></div>
        <ol class="commentList" id="commentList"></ol>
        <p class="muted commentEmpty" id="commentEmpty" hidden>No comments yet. Be the first!</p>
        <button class="button quiet" type="button" id="commentMore" hidden>Show older comments</button>
        <script type="application/json" id="commentData">{{ commentData|raw }}</script>
    </section>
    {% endif %}

    {% if related is not empty %}
    <section>
        <div class="sectionHeader">
            <h2>{{ isApp ? 'More apps' : 'Play something else' }}</h2>
            <a href="/{{ isApp ? 'apps' : 'games' }}">{{ isApp ? 'All apps' : 'All games' }}</a>
        </div>
        {{ g.grid(related) }}
    </section>
    {% endif %}
</div>
<script type="application/json" id="playData">{{ playData|raw }}</script>
<script src="/assets/js/play.js?t=5" defer></script>
{% if commentsOn %}<script src="/assets/js/comments.js?t=2" defer></script>{% endif %}
{% endblock %}
