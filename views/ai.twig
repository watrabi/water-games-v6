{% extends "models/base.twig" %}
{% block pageName %}{{ chat ? chat.title : aiName }}{% endblock %}
{% block bodyClass %}{{ state == 'ready' ? 'aiBody' : '' }}{% endblock %}
{% block headerIncludes %}
<link rel="stylesheet" href="/assets/css/ai.css?t=8">
<script src="/assets/js/bloop.js?t=1"></script>
{% if state == 'ready' %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css" integrity="sha512-rO+olRTkcf304DQBxSWxln8JXCzTHlKnIdnMUwYvQa9/Jd4cQaNkItIUj6Z4nvW1dqK0SKXLbn9h4KwZTNtAyw==" crossorigin="anonymous" referrerpolicy="no-referrer">
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/15.0.12/marked.min.js" integrity="sha512-rCQgmUulW6f6QegOvTntKKb5IAoxTpGVCdWqYjkXEpzAns6XUFs8NKVqWe+KQpctp/EoRSFSuykVputqknLYMg==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.2.6/purify.min.js" integrity="sha512-YlctBG9PGZIhh9keoqI3eZkQM9T8QUbiBi7qNYAO/TUEo8jqWX5pLp5+x1cKRQDRzJ/lyGyJ9WUVNIRduxIIFw==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js" integrity="sha512-EBLzUL8XLl+va/zAsmXwS7Z2B1F9HUHkZwyS/VKwh3S7T/U0nF4BaU29EP/ZSf6zgiIxYAnKLu6bJ8dqpmX5uw==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
{% endif %}
{% endblock %}

{% block footer %}{% if state != 'ready' %}{{ parent() }}{% endif %}{% endblock %}

{% block body %}
{% if state == 'disabled' %}
<div class="page">
    <div class="statusPage">
        <canvas class="bloopStatus" data-bloop="sleep" data-crop="stage" data-hop role="img" aria-label="{{ aiName }} asleep"></canvas>
        <div>
            <p class="code">Not set up</p>
            <h1>{{ aiName }} is napping.</h1>
            <p class="muted">The AI chat is switched off right now. Check back later.</p>
            <a class="button" href="/discover">Go play something</a>
        </div>
    </div>
</div>
{% elseif state == 'guest' %}
<div class="page">
    <div class="statusPage">
        <canvas class="bloopStatus" data-bloop="idle" data-crop="stage" data-hop role="img" aria-label="{{ aiName }}, a little pixel water blob"></canvas>
        <div>
            <p class="code">{{ aiName }}</p>
            <h1>Sign in to chat with {{ aiName }}.</h1>
            <p class="muted">Chats get saved to your account so you can pick them back up later.</p>
            <a class="button" href="/auth/sign-in">Sign in</a>
            <a class="button quiet" href="/auth/sign-up">Make an account</a>
        </div>
    </div>
</div>
{% else %}
<div class="aiPage">
    <aside class="aiChats" id="aiChats" aria-label="Saved chats">
        <a class="button" href="/ai"><i class="ph-bold ph-plus"></i>New chat</a>
        <a class="aiLibraryLink" href="/ai/artifacts"><i class="ph-bold ph-shapes"></i>Artifacts</a>
        {% if aiMemory %}<a class="aiLibraryLink" href="/ai/memory"><i class="ph-bold ph-brain"></i>Memory</a>{% endif %}
        <nav class="aiChatList" id="aiChatList">
            {% for item in chatList %}
                <a href="/ai/{{ item.id }}" data-id="{{ item.id }}"{% if chat and chat.id == item.id %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
            {% else %}
                <p class="muted aiNoChats" id="aiNoChats">Your chats will show up here.</p>
            {% endfor %}
        </nav>
    </aside>
    <div class="aiChatsScrim" id="aiChatsScrim"></div>

    <section class="aiMain">
        <header class="aiHeader">
            <button class="aiIconButton" id="aiChatsToggle" aria-label="Show saved chats"><i class="ph-bold ph-clock-counter-clockwise"></i></button>
            <canvas class="aiHeaderBloop" id="aiHeaderBloop" role="img" aria-label="{{ aiName }}" title="{{ aiName }}"></canvas>
            <h1 id="aiTitle">{{ chat ? chat.title : 'New chat' }}</h1>
            <input id="aiTitleInput" maxlength="120" aria-label="Chat title" hidden>
            <div class="aiHeaderActions" id="aiHeaderActions"{% if not chat %} hidden{% endif %}>
                <button class="aiIconButton" id="aiRename" aria-label="Rename chat" title="Rename"><i class="ph-bold ph-pencil-simple"></i></button>
                <button class="aiIconButton" id="aiDelete" aria-label="Delete chat" title="Delete"><i class="ph-bold ph-trash"></i></button>
            </div>
        </header>

        <div class="aiLog" id="aiLog" aria-live="polite" data-name="{{ aiName }}">
            <div class="aiIntro" id="aiIntro"{% if chat %} hidden{% endif %}>
                <canvas class="aiIntroBloop" id="aiIntroBloop" role="img" aria-label="{{ aiName }}, a little pixel water blob. Tap him!"></canvas>
                <h2>Hey, I'm {{ aiName }}!</h2>
                <p class="muted">I'm the little water blob who lives here. I can find you games on the site, check the weather, look at pictures you attach, and make web pages, games and drawings you can open right here.</p>
                <div class="aiSuggestions" id="aiSuggestions">
                    <button type="button" data-prompt="Find me a good racing game on here">Find me a good racing game on here</button>
                    <button type="button" data-prompt="What's the weather in Tokyo right now?">What's the weather in Tokyo right now?</button>
                    <button type="button" data-prompt="Make me a snake game I can play in the browser">Make me a snake game</button>
                </div>
            </div>
        </div>

        <form class="aiComposer" id="aiComposer">
            <div class="aiAttachments" id="aiAttachments" hidden></div>
            <label class="sr-only" for="aiInput">Message</label>
            <textarea id="aiInput" rows="1" placeholder="Message {{ aiName }}" maxlength="20000"></textarea>
            <div class="aiComposerBar">
                <button type="button" class="aiIconButton" id="aiAttach" aria-label="Attach images" title="Attach images"><i class="ph-bold ph-image"></i></button>
                <input type="file" id="aiFile" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden>
                <label class="sr-only" for="aiModel">Model</label>
                <select id="aiModel">
                    {% for model in models %}
                        <option value="{{ model.id }}">{{ model.label }}</option>
                    {% endfor %}
                </select>
                <span class="aiHint" id="aiHint"></span>
                <button type="submit" class="button" id="aiSend"><i class="ph-bold ph-arrow-up"></i><span>Send</span></button>
            </div>
        </form>
    </section>

    {# filled in by ai.js. previews run in a sandboxed iframe with no access to this site #}
    <aside class="aiArtifactPanel" id="aiArtifactPanel" aria-label="Artifact" hidden>
        <header class="aiArtifactHead">
            <div class="aiArtifactHeadText">
                <h2 id="aiArtifactTitle"></h2>
                <span id="aiArtifactMeta"></span>
            </div>
            <label class="sr-only" for="aiArtifactVersion">Version</label>
            <select id="aiArtifactVersion" hidden></select>
            <button class="aiIconButton" id="aiArtifactClose" aria-label="Close"><i class="ph-bold ph-x"></i></button>
        </header>
        <div class="aiArtifactBar">
            <div class="aiArtifactTabs" id="aiArtifactTabs" role="tablist" aria-label="View">
                <button type="button" role="tab" data-view="preview" aria-selected="true">Preview</button>
                <button type="button" role="tab" data-view="code" aria-selected="false">Code</button>
            </div>
            <div class="aiArtifactActions">
                <button class="aiIconButton small" id="aiArtifactCopy" aria-label="Copy" title="Copy"><i class="ph-bold ph-copy"></i></button>
                <button class="aiIconButton small" id="aiArtifactDownload" aria-label="Download" title="Download"><i class="ph-bold ph-download-simple"></i></button>
                <a class="aiIconButton small" id="aiArtifactNewTab" target="_blank" rel="noopener" aria-label="Open in a new tab" title="Open in a new tab" hidden><i class="ph-bold ph-arrow-square-out"></i></a>
            </div>
        </div>
        <div class="aiArtifactBody">
            <iframe id="aiArtifactFrame" title="Preview" sandbox="allow-scripts allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-downloads"></iframe>
            <div class="aiText aiArtifactDoc" id="aiArtifactDoc" hidden></div>
            <pre class="aiArtifactCode" id="aiArtifactCode" hidden><code></code></pre>
        </div>
    </aside>
</div>
<script id="aiData" type="application/json">{{ aiData|raw }}</script>
<script src="/assets/js/ai.js?t=13" defer></script>
{% endif %}
{% if state != 'ready' %}<script>Bloop.scan();</script>{% endif %}
{% endblock %}
