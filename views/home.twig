{% extends "models/base.twig" %}
{% import "components/games.twig" as g %}
{% import "components/avatar.twig" as a %}
{% block pageName %}Home{% endblock %}

{% block body %}
<div class="page">
    <div class="pageHeader">
        <div class="welcome">
            <img src="/assets/images/BlobEmoji/blobcool.png" alt="" width="56" height="56">
            <div>
                <h1>Welcome back, {{ currentuser.username }}</h1>
                <p>Today's emoji is {{ eotd() }}.{% if totalPlaytime %} You've played for {{ totalPlaytime|playtime }} so far.{% else %} Make of that what you will.{% endif %}</p>
            </div>
        </div>
        <a class="button quiet" href="/discover">All games</a>
    </div>

    {% if recap %}
    <a class="recapCard panel" href="/recap">
        <i class="ph-bold ph-calendar-check"></i>
        <span><strong>Last week:</strong> {{ recap.summary }}{% if recap.daysPlayed > 1 %}, over {{ recap.daysPlayed }} days{% endif %}.</span>
        <span class="recapCardLink">See your week <i class="ph-bold ph-arrow-right"></i></span>
    </a>
    {% endif %}

    {% if gotd %}{{ g.gotd(gotd) }}{% endif %}

    {% if recent is not empty %}
    <section>
        <div class="sectionHeader">
            <h2>Continue playing</h2>
        </div>
        <div class="continueRow">
            {% for game in recent %}
            <a class="continueTile" href="/{{ game.type == 'app' ? 'apps' : 'item' }}/{{ game.id }}">
                <span class="gameIcon">
                    {% if game.gameIcon %}<img src="{{ game.gameIcon }}" alt="" loading="lazy">{% else %}{{ game.name|first|upper }}{% endif %}
                </span>
                <span class="continueText">
                    <span class="gameName">{{ game.name }}</span>
                    <span class="gameMeta">{% if game.seconds %}{{ game.seconds|playtime }} played{% else %}Just started{% endif %} · {{ game.last_played|ago }}</span>
                </span>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <div class="homeColumns">
        <div class="homeMain">
            <section>
                <div class="sectionHeader">
                    <h2>Your favorites</h2>
                    {% if favorites is not empty %}<a href="/favorites">See all</a>{% endif %}
                </div>
                {% if favorites is empty %}
                    {{ g.empty('blobheart', 'Nothing here yet.', 'Hit the heart on any game and it\'ll show up here.') }}
                {% else %}
                    {{ g.grid(favorites) }}
                {% endif %}
            </section>

            <section>
                <div class="sectionHeader">
                    <h2>Trending this week</h2>
                    <a href="/discover?sort=trending">See all</a>
                </div>
                {% if trending is empty %}
                    {{ g.empty('blobsleeping', 'No games yet.', 'Check back soon, they\'re on the way.') }}
                {% else %}
                    {{ g.grid(trending) }}
                {% endif %}
            </section>

            {% if staffPicks is not empty %}
            <section>
                <div class="sectionHeader">
                    <h2>Staff picks</h2>
                    <a href="/collections">All collections</a>
                </div>
                {{ g.collectionGrid(staffPicks) }}
            </section>
            {% endif %}

            {% if newest is not empty %}
            <section>
                <div class="sectionHeader">
                    <h2>Recently added</h2>
                    <a href="/discover?sort=newest">See all</a>
                </div>
                {{ g.grid(newest) }}
            </section>
            {% endif %}
        </div>

        <aside class="homeSide">
            <section class="panel sidePanel progressPanel">
                <h2>Level {{ currentuser.level }}</h2>
                <div class="levelBar" role="progressbar" aria-label="Progress to level {{ currentuser.level + 1 }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ levelProgress }}"><span style="width: {{ levelProgress }}%"></span></div>
                <p class="muted">{{ currentuser.xp|number_format }} / {{ nextLevelXp|number_format }} XP to level {{ currentuser.level + 1 }}</p>
                <p class="streakLine">
                    <i class="{{ streak ? 'ph-fill' : 'ph-bold' }} ph-fire{{ streak ? ' lit' : '' }}"></i>
                    {% if streak %}<strong>{{ streak }} day{{ streak == 1 ? '' : 's' }}</strong> in a row{% else %}No streak right now{% endif %}{% if currentuser.streak_best > 1 %} <span class="muted">· best {{ currentuser.streak_best }}</span>{% endif %}
                </p>
                <p class="muted hint">Play a minute a day to keep it going. XP comes from playtime, achievements and days played.</p>
            </section>

            {% if playingNow is not empty %}
            <section class="panel sidePanel">
                <h2>Friends playing now</h2>
                <ul class="playingList">
                    {% for friend in playingNow %}
                    <li>
                        <a href="/users/{{ friend.username|lower|url_encode }}">{{ a.avatar(friend) }}</a>
                        <span><a href="/users/{{ friend.username|lower|url_encode }}">{{ friend.username }}</a> is playing <a href="/{{ friend.playing.type == 'app' ? 'apps' : 'item' }}/{{ friend.playing.id }}">{{ friend.playing.name }}</a></span>
                    </li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            <section class="panel sidePanel">
                <h2>What's happening</h2>
                {% if feed is empty %}
                    <div class="sideEmpty">
                        <img src="/assets/images/BlobEmoji/blobpeek.png" alt="" width="40" height="40">
                        <p class="muted">Quiet in here. Add some friends from the chat tray and you'll see what they're up to.</p>
                    </div>
                {% else %}
                    <ol class="feedList">
                        {% for item in feed %}
                        <li>
                            <span class="feedIcon"><i class="ph-bold {{ item.icon }}"></i></span>
                            <p>
                                {% if item.user %}<a href="/users/{{ item.user.username|lower|url_encode }}">{{ item.user.username }}</a> {{ item.text }}{% else %}{{ item.text }}:{% endif %}
                                {% if item.game %}<a href="/{{ item.game.type == 'app' ? 'apps' : 'item' }}/{{ item.game.id }}">{{ item.game.name }}</a>{% endif %}
                                <span class="muted feedTime">{{ item.created|ago }}</span>
                            </p>
                        </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        </aside>
    </div>
</div>
{% endblock %}
