{% extends "models/base.twig" %}
{% import "components/games.twig" as g %}
{% block pageName %}Discover{% endblock %}
{% block headerIncludes %}
    <link rel="stylesheet" href="/assets/css/gamepage.css?t=16">
{% endblock %}
{% block body %}
<div class="page">
    <div class="pageHeader">
        <div>
            <h1>{% if search %}Results for “{{ search }}”{% elseif tag %}{{ tag.name }} games{% else %}Games, for you.{% endif %}</h1>
            <p>{{ games|length }} {{ games|length == 1 ? 'game' : 'games' }}{% if search or tag %} · <a href="/discover?sort={{ sort }}">clear {{ search ? 'search' : 'filter' }}</a>{% endif %}{% if currentuser %} · <a href="/discover/request">Can't find one? Request it</a>{% endif %} · <a href="/item/random{{ currentuser ? '?unplayed=1' : '' }}" title="Random game (G then R)"><i class="ph-bold ph-shuffle"></i> Random{{ currentuser ? ' one you haven\'t played' : '' }}</a></p>
        </div>
        <form class="pageSearch" action="/discover" method="get" role="search">
            <input type="hidden" name="sort" value="{{ sort }}">
            {% if tag %}<input type="hidden" name="tag" value="{{ tag.slug }}">{% endif %}
            <label class="sr-only" for="pageSearchInput">Search games</label>
            <input id="pageSearchInput" type="search" name="q" placeholder="Search games" value="{{ search }}">
        </form>
        <nav class="sortTabs" aria-label="Sort games">
            {% for key, label in {popular: 'Popular', trending: 'Trending', liked: 'Top rated', newest: 'Newest', name: 'A–Z'} %}
                <a href="/discover?sort={{ key }}{% if search %}&q={{ search|url_encode }}{% endif %}{% if tag %}&tag={{ tag.slug }}{% endif %}"{% if sort == key %} class="active" aria-current="true"{% endif %}>{{ label }}</a>
            {% endfor %}
        </nav>
    </div>

    {% if tags is not empty %}
    <nav class="tagChips" aria-label="Categories">
        <a href="/discover?sort={{ sort }}{% if search %}&q={{ search|url_encode }}{% endif %}" class="tagChip{{ not tag ? ' active' : '' }}"{% if not tag %} aria-current="true"{% endif %}>All</a>
        {% for item in tags %}
            <a href="/discover?sort={{ sort }}&tag={{ item.slug }}{% if search %}&q={{ search|url_encode }}{% endif %}" class="tagChip{{ tag and tag.id == item.id ? ' active' : '' }}"{% if tag and tag.id == item.id %} aria-current="true"{% endif %}>{{ item.name }}</a>
        {% endfor %}
    </nav>
    {% endif %}

    {% if gotd %}{{ g.gotd(gotd) }}{% endif %}

    {% if staffPicks is not empty %}
    <section>
        <div class="sectionHeader"><h2>Staff picks</h2><a href="/collections">All collections</a></div>
        {{ g.collectionGrid(staffPicks) }}
    </section>
    {% endif %}

    {% if games is empty %}
        {% if search %}
            {{ g.empty('blobthinkingeyes', 'Nothing matched that.', 'Try a shorter search, or <a href="/discover">browse everything</a>.') }}
        {% else %}
            {{ g.empty('blobsleeping', 'Nothing yet.', 'Games are on the way.') }}
        {% endif %}
    {% else %}
        {{ g.grid(games) }}
    {% endif %}
</div>
{% endblock %}
