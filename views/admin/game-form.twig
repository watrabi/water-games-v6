{% extends "admin/base.twig" %}
{% import "admin/macros.twig" as m %}
{% set noun = game.type == 'app' ? 'app' : 'game' %}
{% block adminTitle %}{{ game.id ? game.name : 'New ' ~ noun }}{% endblock %}
{% block admin %}
<div class="pageHeader">
    <div>
        <h1>{{ game.id ? game.name : 'New ' ~ noun }}</h1>
        <p><a href="/admin/games?type={{ game.type }}">Back to {{ noun }}s</a>{% if game.id %} · <a href="/{{ game.type == 'app' ? 'apps' : 'item' }}/{{ game.id }}" target="_blank" rel="noopener">Open on the site</a> · {{ game.plays|number_format }} plays{% endif %}</p>
    </div>
    {% if game.id %}{{ m.deleteButton('/admin/games/' ~ game.id ~ '/delete', 'this ' ~ noun) }}{% endif %}
</div>

<form class="panel adminForm" method="post" action="/admin/games/save" enctype="multipart/form-data">
    {{ m.csrf() }}
    <input type="hidden" name="id" value="{{ game.id }}">

    <div class="formRow">
        <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" value="{{ game.name }}" maxlength="200" required>
        </div>
        <div class="field narrowField">
            <label for="type">Type</label>
            <select id="type" name="type">
                <option value="game"{% if game.type == 'game' %} selected{% endif %}>Game</option>
                <option value="app"{% if game.type == 'app' %} selected{% endif %}>App</option>
            </select>
        </div>
    </div>

    <div class="field">
        <label for="description">Description <span class="muted">(optional)</span></label>
        <textarea id="description" name="description">{{ game.description }}</textarea>
    </div>

    <div class="field">
        <label for="controls">Controls <span class="muted">(optional)</span></label>
        <textarea id="controls" name="controls" rows="3" maxlength="2000" placeholder="Arrow keys to move&#10;Space to jump">{{ game.controls }}</textarea>
        <p class="hint">One per line. Shows under the game as "How to play".</p>
    </div>

    <div class="field">
        <label for="gamePath">Game path</label>
        <input id="gamePath" name="gamePath" value="{{ game.gamePath }}" class="mono" placeholder="/game-files/slope/index.html" required>
        <p class="hint">The page the player loads in a frame. Usually the game's index.html under public/game-files, or a full URL.</p>
    </div>

    <div class="field">
        <label for="gameIcon">Icon</label>
        <div class="fileRow">
            <span class="adminThumb large" id="iconPreview">{% if game.gameIcon %}<img src="{{ game.gameIcon }}" alt="">{% else %}{{ game.name ? game.name|first|upper : '?' }}{% endif %}</span>
            <div class="fileInputs">
                <input id="gameIcon" name="gameIcon" value="{{ game.gameIcon }}" class="mono" placeholder="/game-files/icons/slope.png">
                <input type="file" name="iconFile" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="#iconPreview" aria-label="Upload an icon">
                <p class="hint">Paste a path, or upload a square image (it replaces the path). Leave both empty to show the first letter.</p>
            </div>
        </div>
    </div>

    {% set shots = game.screenshots ? game.screenshots|json_decode : [] %}
    <fieldset class="field">
        <legend>Screenshots <span class="muted">(optional, up to 6)</span></legend>
        {% if shots is not empty %}
        <div class="shotPicker">
            {% for shot in shots %}
            <label class="shotKeep">
                <img src="{{ shot }}" alt="Screenshot {{ loop.index }}" loading="lazy">
                <span class="checkRow"><input type="checkbox" name="keepShots[]" value="{{ shot }}" checked><span>Keep</span></span>
            </label>
            {% endfor %}
        </div>
        {% endif %}
        <input type="file" name="shotFiles[]" accept="image/png,image/jpeg,image/gif,image/webp" multiple aria-label="Add screenshots">
        <p class="hint">Untick one to remove it when you save. The first one is also what shows when someone shares the link.</p>
    </fieldset>

    {% if game.type == 'game' %}
    <fieldset class="field">
        <legend>Leaderboard</legend>
        <p class="hint">Only works for games that send scores with <code>watr.submitScore(n)</code> from <code>/assets/js/watr-sdk.js</code> (see the readme).{% if scoreCount is defined and scoreCount %} {{ scoreCount|number_format }} {{ scoreCount == 1 ? 'person has' : 'people have' }} a score.{% endif %}</p>
        <div class="formRow">
            <div class="field narrowField">
                <label for="scores">Scores</label>
                <select id="scores" name="scores">
                    <option value="off"{% if game.scores == 'off' %} selected{% endif %}>Off</option>
                    <option value="high"{% if game.scores == 'high' %} selected{% endif %}>Higher is better</option>
                    <option value="low"{% if game.scores == 'low' %} selected{% endif %}>Lower is better</option>
                </select>
            </div>
            <div class="field narrowField">
                <label for="score_format">Shown as</label>
                <select id="score_format" name="score_format">
                    <option value="number"{% if game.score_format == 'number' %} selected{% endif %}>A number</option>
                    <option value="time"{% if game.score_format == 'time' %} selected{% endif %}>A time (sent in ms)</option>
                </select>
            </div>
            <div class="field narrowField">
                <label for="score_label">Label</label>
                <input id="score_label" name="score_label" value="{{ game.score_label }}" maxlength="20" placeholder="points">
            </div>
            <div class="field narrowField">
                <label for="score_max">Highest believable</label>
                <input id="score_max" name="score_max" value="{{ game.score_max }}" inputmode="numeric" placeholder="no limit">
            </div>
        </div>
    </fieldset>

    <label class="checkRow"><input type="checkbox" name="pin" value="1"{% if pinned %} checked{% endif %}><span>Make this today's game of the day{% if isGotd is defined and isGotd and not pinned %} <span class="muted">(it already is, picked automatically)</span>{% endif %}</span></label>
    {% endif %}

    {% if allTags is defined and allTags is not empty %}
    <fieldset class="field tagPicker">
        <legend>Categories <span class="muted">· <a href="/admin/tags">edit the list</a></span></legend>
        {% for tag in allTags %}
            <label class="checkRow"><input type="checkbox" name="tags[]" value="{{ tag.id }}"{% if tag.id in gameTags %} checked{% endif %}><span>{{ tag.name }}</span></label>
        {% endfor %}
    </fieldset>
    {% endif %}

    {% if request is defined and request %}
    <input type="hidden" name="request" value="{{ request.id }}">
    <p class="notice">Adding this closes {{ request.username ?? 'the' }} request for “{{ request.name }}”{% if request.url %} (they linked <a href="{{ request.url }}" target="_blank" rel="noopener nofollow">{{ request.url }}</a>){% endif %} and lets them know.</p>
    {% endif %}

    {% if game.id %}
    <label class="checkRow"><input type="checkbox" name="resetPlays" value="1"><span>Reset the play count to 0</span></label>
    {% endif %}

    <button class="button" type="submit">{{ game.id ? 'Save changes' : 'Add ' ~ noun }}</button>
</form>
{% endblock %}
