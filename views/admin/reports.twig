{% extends "admin/base.twig" %}
{# what the reported message said before its author changed it #}
{% macro edits(report) %}
  {% if report.edits is defined and report.edits is not empty %}
  <div class="notice reportEdits">
    <strong>Changed after sending.</strong> Earlier versions, oldest first:
    <ol>{% for e in report.edits %}<li><span class="reportText">{{ e.body ?: '(no text)' }}</span> <span class="muted">· replaced {{ e.created|date("M j, g:i A") }}</span></li>{% endfor %}</ol>
  </div>
  {% endif %}
{% endmacro %}
{% import "admin/macros.twig" as m %}
{% block adminTitle %}Reports{% endblock %}

{% macro action(report, action, label, danger, confirm, kind) %}
  <form method="post" action="/admin/reports/{{ kind == 'comments' ? 'comments/' : (kind == 'games' ? 'games/' : '') }}{{ report.id }}/action" class="inlineForm"{% if confirm %} data-confirm="{{ confirm }}"{% endif %}>
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="action" value="{{ action }}">
    <button type="submit" class="button{{ danger ? ' quiet danger' : ' quiet' }}">{{ label }}</button>
  </form>
{% endmacro %}
{% import _self as r %}

{% block admin %}
<div class="pageHeader">
    <div>
        <h1>Reports</h1>
        <p>{{ total|number_format }} {{ status }} {{ {comments: 'comment', games: 'broken game', groups: 'group chat'}[kind] ?? 'chat' }} report{{ total == 1 ? '' : 's' }}{% if status == 'open' %}, oldest first{% endif %}</p>
    </div>
    <nav class="sortTabs" aria-label="Report status">
        {% for key, label in {open: 'Open', actioned: 'Acted on', dismissed: 'Dismissed'} %}
            <a href="?kind={{ kind }}&amp;status={{ key }}"{% if status == key %} class="active" aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
</div>
<nav class="sortTabs reportKinds" aria-label="Report type">
    <a href="?kind=chat&amp;status={{ status }}"{% if kind == 'chat' %} class="active" aria-current="true"{% endif %}>Chat{% if openChat %} <span class="navCount">{{ openChat }}</span>{% endif %}</a>
    <a href="?kind=groups&amp;status={{ status }}"{% if kind == 'groups' %} class="active" aria-current="true"{% endif %}>Group chats{% if openGroups %} <span class="navCount">{{ openGroups }}</span>{% endif %}</a>
    <a href="?kind=comments&amp;status={{ status }}"{% if kind == 'comments' %} class="active" aria-current="true"{% endif %}>Comments{% if openComments %} <span class="navCount">{{ openComments }}</span>{% endif %}</a>
    <a href="?kind=games&amp;status={{ status }}"{% if kind == 'games' %} class="active" aria-current="true"{% endif %}>Broken games{% if openGames %} <span class="navCount">{{ openGames }}</span>{% endif %}</a>
</nav>

{% if rows is empty %}
    <div class="empty"><img src="/assets/images/BlobEmoji/blobcool.png" alt=""><div><strong>Nothing to look at.</strong>{% if status == 'open' %}No open reports right now.{% endif %}</div></div>
{% endif %}

{% for report in rows %}
<article class="panel reportCard">
    <header class="reportHead">
        <div>
            <strong>{{ reasons[report.reason] ?? report.reason }}</strong>
            <span class="muted">· reported by <a href="/users/{{ report.reporter_name|lower|url_encode }}">{{ report.reporter_name }}</a> {{ report.created|date("M j, g:i A") }}</span>
        </div>
        {% if report.status == 'open' and kind == 'games' %}
        <div class="rowActions">
            {{ r.action(report, 'dismiss', 'Dismiss', false, null, kind) }}
            {{ r.action(report, 'fixed', 'Mark fixed', false, null, kind) }}
        </div>
        {% elseif report.status == 'open' %}
        <div class="rowActions">
            {% set noun = kind == 'comments' ? 'comment' : 'message' %}
            {{ r.action(report, 'dismiss', 'Dismiss', false, null, kind) }}
            {{ r.action(report, 'remove', 'Remove ' ~ noun, true, null, kind) }}
            {% if not report.sender_banned %}
                {{ r.action(report, 'ban', 'Remove + ban ' ~ report.sender_name, true, 'Remove the ' ~ noun ~ ' and ban ' ~ report.sender_name ~ '? They\'ll be signed out everywhere.', kind) }}
            {% endif %}
        </div>
        {% else %}
            <span class="muted">{{ report.action ?: report.status }}{% if report.handler_name %} by {{ report.handler_name }}{% endif %}{% if report.handled_at %}, {{ report.handled_at|date("M j") }}{% endif %}</span>
        {% endif %}
    </header>

    {% if report.details %}<p class="reportDetails">“{{ report.details }}”</p>{% endif %}

    {% if kind == 'games' %}
    <p class="muted reportWho">
        <a href="/{{ report.game_type == 'app' ? 'apps' : 'games' }}/{{ report.gameid }}" target="_blank" rel="noopener">{{ report.game_name ?: 'A deleted game' }}</a>
        {% if report.gamePath %}· <code>{{ report.gamePath }}</code>{% endif %}
        · <a href="/admin/games/{{ report.gameid }}">Edit</a>
    </p>
    {% elseif kind == 'comments' %}
    <p class="muted reportWho">
        By <a href="/users/{{ report.sender_name|lower|url_encode }}">{{ report.sender_name }}</a>{% if report.sender_banned %} <span class="badge danger">banned</span>{% endif %}
        on <a href="/{{ report.game_type == 'app' ? 'apps' : 'games' }}/{{ report.gameid }}">{{ report.game_name ?: 'a deleted game' }}</a>, {{ report.sent|date("M j, g:i A") }}:
    </p>
    <ol class="reportContext">
        <li class="reported fromSender">
            <span class="reportAuthor">{{ report.sender_name }}</span>
            <span class="reportBody"><span class="reportText">{{ report.body }}</span>{% if report.deleted %} <span class="badge">removed</span>{% endif %}</span>
            <span class="reportWhen">{{ report.sent|date("M j, g:i A") }}</span>
        </li>
    </ol>
    {{ r.edits(report) }}
    {% else %}
    <p class="muted reportWho">
        From <a href="/users/{{ report.sender_name|lower|url_encode }}">{{ report.sender_name }}</a>{% if report.sender_banned %} <span class="badge danger">banned</span>{% endif %}
        {% if kind == 'groups' %}in the group “{{ report.group_name }}”{% else %}to {{ report.reporter_name }}{% endif %}. The conversation around it:
    </p>

    <ol class="reportContext">
        {% for msg in report.context %}
            <li class="{{ msg.id == report.message_id ? 'reported' : '' }}{{ msg.sender_id == report.sender_id ? ' fromSender' : '' }}">
                <span class="reportAuthor">{{ msg.username }}</span>
                <span class="reportBody">
                    {% if msg.image_id %}<a href="/chat/images/{{ msg.image_id }}" target="_blank" rel="noopener"><img src="/chat/images/{{ msg.image_id }}" alt="Image in the chat"></a>{% endif %}
                    {% if msg.body %}<span class="reportText">{{ msg.body }}</span>{% endif %}
                    {% if msg.deleted %}<span class="badge">{{ msg.deleted == 2 ? 'deleted by sender' : 'removed' }}</span>{% endif %}
                </span>
                <span class="reportWhen">{{ msg.created|date("M j, g:i A") }}</span>
            </li>
        {% endfor %}
    </ol>
    {{ r.edits(report) }}
    {% endif %}
</article>
{% endfor %}

{{ m.pager(page, pages, {kind: kind, status: status}) }}
{% endblock %}
