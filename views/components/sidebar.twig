{% set here = path ?? '/' %}
{% macro item(href, icon, label, here, match) %}
  <a class="sidebarItem{{ here == href or (match and here starts with match) ? ' active' : '' }}" href="{{ href }}"{{ here == href ? ' aria-current="page"' : '' }}><i class="{{ icon }}"></i>{{ label }}</a>
{% endmacro %}
{% import _self as nav %}
<nav id="sidebar" aria-label="Main">
  {% if currentuser %}
    {{ nav.item('/home', 'fa-solid fa-house', 'Home', here) }}
  {% else %}
    {{ nav.item('/', 'fa-solid fa-house', 'Home', here) }}
  {% endif %}
  {{ nav.item('/games', 'fa-solid fa-gamepad', 'Games', here, '/games/') }}
  {% if currentuser %}
    {{ nav.item('/favorites', 'fa-solid fa-heart', 'Favorites', here) }}
  {% endif %}

  <p class="sidebarHeading">Coming later</p>
  <a class="sidebarItem later{{ here == '/proxy' ? ' active' : '' }}" href="/proxy"><i class="fa-brands fa-chrome"></i>Proxy<span class="tag">soon</span></a>
  <a class="sidebarItem later{{ here == '/apps' ? ' active' : '' }}" href="/apps"><i class="fa-brands fa-windows"></i>Apps<span class="tag">soon</span></a>
  <a class="sidebarItem later{{ here == '/music' ? ' active' : '' }}" href="/music"><i class="fa-solid fa-music"></i>Music<span class="tag">soon</span></a>
</nav>
