{% set here = path ?? '/' %}
{% macro item(href, icon, label, here, match) %}
  <a class="sidebarItem{{ here == href or (match and here starts with match) ? ' active' : '' }}" href="{{ href }}"{{ here == href ? ' aria-current="page"' : '' }}><i class="{{ icon }}"></i>{{ label }}</a>
{% endmacro %}
{% import _self as nav %}
<nav id="sidebar" aria-label="Main">
  {% if currentuser %}
    {{ nav.item('/home', 'ph-bold ph-house', 'Home', here) }}
  {% else %}
    {{ nav.item('/', 'ph-bold ph-house', 'Home', here) }}
  {% endif %}
  {{ nav.item('/games', 'ph-bold ph-game-controller', 'Games', here, '/games/') }}
  {{ nav.item('/apps', 'ph-bold ph-squares-four', 'Apps', here, '/apps/') }}
  {{ nav.item('/music', 'ph-bold ph-music-notes', 'Music', here) }}
  {{ nav.item('/collections', 'ph-bold ph-folders', 'Collections', here, '/collections/') }}
  {% if aiEnabled %}
    {{ nav.item('/ai', 'ph-bold ph-chats', 'AI', here, '/ai/') }}
  {% endif %}
  {% if currentuser %}
    <p class="sidebarHeading">Yours</p>
    {{ nav.item('/favorites', 'ph-bold ph-heart', 'Favorites', here) }}
    {{ nav.item('/music/playlists', 'ph-bold ph-playlist', 'Playlists', here, '/music/playlists/') }}
    {{ nav.item('/notifications', 'ph-bold ph-bell', 'Notifications', here) }}
    {{ nav.item('/recap', 'ph-bold ph-calendar-check', 'Your week', here) }}
    {{ nav.item('/games/request', 'ph-bold ph-lightbulb', 'Request a game', here) }}
  {% endif %}
</nav>
