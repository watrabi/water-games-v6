{% import "components/avatar.twig" as a %}
<header id="navbar">
  <button id="sidebarToggle" aria-label="Toggle sidebar" aria-controls="sidebar"><i class="ph-bold ph-list"></i></button>
  <a href="{{ currentuser ? '/home' : '/' }}" id="branding">Water <em>Games</em>{% if theme.emoji %}<span class="brandEmoji" aria-hidden="true">{{ theme.emoji }}</span>{% endif %}</a>

  <form id="navSearch" action="/games" method="get" role="search">
    <i class="ph-bold ph-magnifying-glass"></i>
    <label class="sr-only" for="navSearchInput">Search games</label>
    <input id="navSearchInput" type="search" name="q" placeholder="Search games" value="{{ search ?? '' }}" autocomplete="off">
  </form>

  <div class="navActions">
    {% if not currentuser %}
      <a class="button quiet" href="/auth/sign-in">Sign in</a>
      <a class="button" href="/auth/sign-up">Sign up</a>
    {% else %}
      <div class="notifyMenu" id="notifyMenu">
        <button type="button" class="notifyButton" id="notifyButton" aria-haspopup="true" aria-expanded="false" aria-controls="notifyPanel" title="Notifications">
          <i class="ph-bold ph-bell"></i>
          <span class="notifyBadge" id="notifyBadge"{% if not unreadNotifications %} hidden{% endif %}>{{ unreadNotifications > 9 ? '9+' : unreadNotifications }}</span>
          <span class="sr-only" id="notifyLabel">{{ unreadNotifications }} unread notification{{ unreadNotifications == 1 ? '' : 's' }}</span>
        </button>
        <section class="notifyPanel" id="notifyPanel" aria-label="Notifications" hidden>
          <header class="notifyHead">
            <h2>Notifications</h2>
            <button type="button" class="linkButton" id="notifyReadAll">Mark all read</button>
          </header>
          <ol class="notifyList" id="notifyList"></ol>
          <a class="notifyAll" href="/notifications">See all</a>
        </section>
      </div>
      <div class="dropdown" id="userMenu">
        <button class="navUser" aria-haspopup="true" aria-expanded="false">
          <span class="navAvatar" id="navAvatar">
            {{ a.avatar(currentuser) }}
            {% if openReports %}<span class="reportBadge" title="{{ openReports }} report{{ openReports == 1 ? '' : 's' }} to review">{{ openReports > 9 ? '9+' : openReports }}<span class="sr-only"> report{{ openReports == 1 ? '' : 's' }} to review</span></span>{% endif %}
          </span>
          <span class="navUsername">{{ currentuser.username }}</span>
          <i class="ph-bold ph-caret-down"></i>
        </button>
        <div class="dropdown-content">
          <a class="dropdownItem" href="/users/{{ currentuser.username|lower|url_encode }}">Profile</a>
          <a class="dropdownItem" href="/favorites">Favorites</a>
          <a class="dropdownItem" href="/music/playlists">Playlists</a>
          <a class="dropdownItem" href="/games/request">Request a game</a>
          <a class="dropdownItem" href="/settings">Settings</a>
          {% if currentuser.admin %}
          <a class="dropdownItem" href="/admin">Admin panel</a>
          {% if openReports %}<a class="dropdownItem reportItem" href="/admin/reports">Reports to review <span class="reportCount">{{ openReports }}</span></a>{% endif %}
          {% endif %}
          <hr>
          <a class="dropdownItem" href="/auth/logout">Sign out</a>
        </div>
      </div>
    {% endif %}
  </div>
</header>
