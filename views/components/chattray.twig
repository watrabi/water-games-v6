{# friends + chat tray, bottom left. chat.js fills it in #}
<div class="chatTray" id="chatTray">
  <button type="button" class="chatToggle" id="chatToggle" aria-expanded="false" aria-controls="chatPanel">
    <i class="ph-bold ph-chats"></i><span class="chatToggleLabel">Chat</span>
    <span class="chatBadge" id="chatBadge" hidden></span>
  </button>

  <section class="chatPanel" id="chatPanel" aria-label="Chat" hidden>
    <header class="chatHead">
      <button type="button" class="chatIcon" id="chatBack" aria-label="Back to friends" hidden><i class="ph-bold ph-arrow-left"></i></button>
      <div class="chatTitle">
        <span id="chatTitle">Friends</span>
        <span class="chatSub" id="chatSub"></span>
      </div>
      <details class="chatMenu" id="chatMenu" hidden>
        <summary class="chatIcon" aria-label="More options"><i class="ph-bold ph-dots-three"></i></summary>
        <div class="chatMenuItems" id="chatDmMenu">
          <a id="chatProfileLink" href="#">View profile</a>
          <button type="button" data-convo-act="remove">Unfriend</button>
          <button type="button" data-convo-act="block">Block</button>
        </div>
        <div class="chatMenuItems" id="chatGroupMenu" hidden>
          <button type="button" data-group-act="members">People in this group</button>
          <button type="button" data-group-act="add">Add people</button>
          <button type="button" data-group-act="rename">Rename</button>
          <button type="button" data-group-act="leave">Leave group</button>
        </div>
      </details>
      <button type="button" class="chatIcon" id="chatClose" aria-label="Close chat"><i class="ph-bold ph-minus"></i></button>
    </header>

    <div class="chatView" id="chatHome">
      <form class="chatSearch" id="chatSearchForm" role="search">
        <i class="ph-bold ph-user-plus"></i>
        <label class="sr-only" for="chatSearch">Add friends by username</label>
        <input id="chatSearch" type="search" placeholder="Add friends by username" autocomplete="off" maxlength="20">
      </form>
      {# your status line, friends see it under your name #}
      <div class="chatStatus">
        <button type="button" class="chatStatusShow" id="chatStatusShow" aria-expanded="false" aria-controls="chatStatusForm">
          <i class="ph-bold ph-chat-teardrop-dots"></i><span id="chatStatusText">Set a status</span>
        </button>
        <form class="chatStatusForm" id="chatStatusForm" hidden>
          <label class="sr-only" for="chatStatusInput">Your status</label>
          <input id="chatStatusInput" maxlength="80" autocomplete="off" placeholder="What are you up to?">
          <div class="chatStatusRow">
            <label class="sr-only" for="chatStatusFor">Clear it after</label>
            <select id="chatStatusFor">
              <option value="3600">for an hour</option>
              <option value="14400">for 4 hours</option>
              <option value="86400" selected>for a day</option>
              <option value="0">until I clear it</option>
            </select>
            <button type="button" class="chatSmall" id="chatStatusClear">Clear</button>
            <button type="submit" class="chatSmall primary">Save</button>
          </div>
          <p class="chatNotice error" id="chatStatusError" hidden></p>
        </form>
      </div>
      <div class="chatList" id="chatResults" hidden></div>
      <div class="chatList" id="chatRequests"></div>
      <div class="chatList" id="chatGroups"></div>
      <div class="chatList" id="chatFriends"></div>
    </div>

    {# picking friends for a new group, or adding people to one #}
    <form class="chatView chatPicker" id="chatPicker" hidden>
      <div class="chatPickerName" id="chatPickerNameRow">
        <label for="chatPickerName">Group name <span class="chatMeta">(optional)</span></label>
        <input id="chatPickerName" maxlength="50" autocomplete="off">
      </div>
      <p class="chatHeading" id="chatPickerHeading">Pick at least two friends</p>
      <div class="chatList chatPickerList" id="chatPickerList"></div>
      <p class="chatNotice error" id="chatPickerError" hidden></p>
      <div class="chatPickerActions">
        <button type="button" class="button quiet" id="chatPickerCancel">Cancel</button>
        <button type="submit" class="button" id="chatPickerSubmit">Make group</button>
      </div>
    </form>

    {# who's in a group #}
    <div class="chatView" id="chatMembers" hidden>
      <div class="chatList" id="chatMembersList"></div>
    </div>

    <div class="chatView chatConvoView" id="chatConvo" hidden>
      <div class="chatMessages" id="chatMessages" aria-live="polite"></div>
      <p class="chatNotice" id="chatNotice" hidden></p>
      <form class="chatComposer" id="chatComposer">
        <div class="chatAttachment" id="chatAttachment" hidden></div>
        <div class="chatComposerRow">
          <button type="button" class="chatIcon" id="chatImageButton" aria-label="Send an image"><i class="ph-bold ph-image"></i></button>
          <input type="file" id="chatFile" accept="image/png,image/jpeg,image/gif,image/webp" hidden>
          <label class="sr-only" for="chatInput">Message</label>
          <textarea id="chatInput" rows="1" maxlength="1000" placeholder="Message"></textarea>
          <button type="submit" class="chatIcon chatSend" id="chatSend" aria-label="Send"><i class="ph-bold ph-paper-plane-right"></i></button>
        </div>
      </form>
    </div>

    <form class="chatReport" id="chatReport" hidden>
      <h3>Report this message</h3>
      <blockquote id="chatReportQuote"></blockquote>
      <fieldset id="chatReportReasons">
        <legend class="sr-only">Why are you reporting it?</legend>
      </fieldset>
      <label for="chatReportDetails">Anything else? <span class="muted">(optional)</span></label>
      <textarea id="chatReportDetails" maxlength="1000"></textarea>
      <p class="chatReportNote">A moderator will see this message and the ones around it. They won't tell the other person who reported it.</p>
      <div class="chatReportActions">
        <button type="button" class="button quiet" id="chatReportCancel">Cancel</button>
        <button type="submit" class="button" id="chatReportSend">Send report</button>
      </div>
    </form>
  </section>
</div>
<script src="/assets/js/chat.js?t=7" defer></script>
