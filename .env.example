# Generic Stuff
APP_NAME="Water Games"
APP_DESC="water game"
APP_ENV=production
APP_DEBUG=true
APP_DOMAIN="watr.lol"

# Cookie Stuff 
COOKIE_NAME="WATR-AUTH"

# Encryption
encryptionIv=""
encryptionKey=""

# Mail, for "forgot password" emails. any SMTP server works (your host's, Gmail with an app password,
# Resend, Mailgun...). with no MAIL_HOST and APP_DEBUG=true, emails are written to storage/logs/mail.log instead
MAIL_HOST=""
MAIL_PORT=587
MAIL_SECURE="tls"              # tls (STARTTLS, port 587) | ssl (port 465) | none
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""                   # e.g. "noreply@watr.lol", defaults to MAIL_USER

# The site's public address, for share previews, the sitemap and emails. defaults to https://APP_DOMAIN
SITE_URL=""

# Alerts from bin/cron.php when a health check starts or stops failing (database, realtime, disk, backups).
# a Discord or Slack incoming webhook url, and/or an email address (needs MAIL_HOST)
ALERT_WEBHOOK=""
ALERT_EMAIL=""

# Captcha
CONFIG_CaptchaEnabled=true # if you ever plan to make this public, please make sure this is enabled
PrivateTurnstileKey=""
TurnstileSiteKey=""

# Storage (R2)
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_KEY_ID=""
R2_SECRET=""

# VPN Detection stuff
IPHUB_APIKEY="="

# Maintenance Toggles
MAINTENANCE=true
HARD_MAINTENANCE=false

#for maintenance bypass stuff
BypassCookieName=""
BypassCookieValue=""

# Database
DB_HOST=""
DB_NAME=""
DB_USER=""
DB_PASS=""

# AI chat (/ai). Turn it on and fill in at least one provider's model list.
AI_ENABLED=false
AI_DAILY_LIMIT=100             # messages per user per day, 0 = no limit
AI_DAILY_UPLOADS=50            # images per user per day
AI_DEFAULT_MODEL=""            # e.g. "anthropic:claude-opus-5-5", otherwise the first model listed
AI_TOOLS="time,calculator,site_search,weather,memory,themes"   # add "fetch" to let it read web pages, "exa" to search the web. "memory" lets it remember people between chats, "themes" lets it make site themes for each person
EXA_API_KEY=""                 # exa.ai key for web search (can also be set in the admin panel)
AI_SYSTEM_PROMPT=""            # extra instructions added to the built in prompt
AI_TIMEOUT=600

# model lists are comma separated, "name" or "name=Display Name"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODELS=""               # e.g. "gemma3:12b=Gemma 3, qwen3:8b=Qwen 3"
OLLAMA_KEY=""                  # only if your ollama sits behind auth
OLLAMA_KEEP_ALIVE=""

# anthropic, or anything that speaks the anthropic messages api
ANTHROPIC_URL="https://api.anthropic.com"
ANTHROPIC_KEY=""
ANTHROPIC_MODELS=""            # e.g. "claude-opus-5-5=Claude Opus 5.5"
ANTHROPIC_MAX_TOKENS=64000
ANTHROPIC_EFFORT=""            # low | medium | high | xhigh | max, empty = model default
ANTHROPIC_THINKING=""          # "summarized" shows the model's thinking in the chat
ANTHROPIC_FALLBACKS=true       # api.anthropic.com only: retry declined requests on anthropic's recommended fallback model

# openai, or anything that speaks the openai chat completions api (openrouter, lm studio, vllm, groq...)
OPENAI_URL="https://api.openai.com/v1"
OPENAI_KEY=""
OPENAI_MODELS=""
OPENAI_MAX_TOKENS=""

# realtime chat (realtime/ node server). leave REALTIME_URL empty to keep using polling
REALTIME_URL=""                 # what browsers connect to, e.g. wss://watr.lol/ws
REALTIME_INTERNAL_URL="http://127.0.0.1:3001"   # where PHP reaches the node server
REALTIME_SECRET=""              # 16+ random characters, same value in the node server's environment

# web proxy (/proxy, the proxy/ node service). leave empty for no proxy
PROXY_SECRET=""                 # 16+ random characters, same value in the proxy service's environment
PROXY_INTERNAL_URL="http://127.0.0.1:3002"      # where PHP checks the proxy's health
